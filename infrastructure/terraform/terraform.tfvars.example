aws_region = "eu-west-1"
aws_account_id = "123456789012"

# Use existing suitable subnets from one VPC and at least two availability zones.
# Terraform creates a dedicated security group with no inbound rules.
subnet_ids = ["subnet-REPLACE-ONE", "subnet-REPLACE-TWO"]

base_capacity = 4
daily_rpu_hours = 8

# Optional monthly AWS Budget notification, not a cash cap.
budget_email = ""
monthly_budget_usd = 20
